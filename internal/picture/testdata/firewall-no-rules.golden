	map firewall_in4 {
		type ipv4_addr : verdict
		flags interval
		elements = { 198.19.0.2 : jump server_1000002_in, 198.19.0.5 : jump server_1000002_in }
	}
	map firewall_in6 {
		type ipv6_addr : verdict
		flags interval
		elements = { 2001:db8:1:5::/64 : jump server_1000002_in }
	}
	map firewall_out4 {
		type ipv4_addr : verdict
		flags interval
	}
	map firewall_out6 {
		type ipv6_addr : verdict
		flags interval
	}

	chain firewall_out {
		type filter hook forward priority filter + 10; policy accept;
		iifname "public" oifname { "public", "uplink" } ip saddr vmap @firewall_out4
		iifname "public" oifname { "public", "uplink" } ip6 saddr vmap @firewall_out6
	}

	chain firewall_in {
		type filter hook forward priority filter + 20; policy accept;
		oifname "public" ip daddr vmap @firewall_in4
		oifname "public" ip6 daddr vmap @firewall_in6
	}

	chain server_1000002_in {
		ct state established,related accept
		tcp flags & (syn | ack) == ack accept
		drop
	}

