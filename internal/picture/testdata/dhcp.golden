### public
# dnsmasq for the servers' public NICs, built by hlabd.
port=0
interface=public
bind-dynamic
dhcp-authoritative
leasefile-ro
dhcp-option=option:netmask,255.255.255.255
dhcp-option=option:router,172.31.1.1
dhcp-option=121,172.31.1.1/32,0.0.0.0,0.0.0.0/0,172.31.1.1
dhcp-option=249,172.31.1.1/32,0.0.0.0,0.0.0.0/0,172.31.1.1
dhcp-option=option:dns-server,198.18.0.2
dhcp-option=tag:ipv6only,121,172.31.1.1/32,0.0.0.0,169.254.169.254/32,172.31.1.1,188.40.24.200/32,172.31.1.1
dhcp-option=tag:ipv6only,249,172.31.1.1/32,0.0.0.0,169.254.169.254/32,172.31.1.1,188.40.24.200/32,172.31.1.1
dhcp-option=tag:ipv6only,option:dns-server
# server 1000001
shared-network=172.31.1.1,198.19.0.1
dhcp-range=198.19.0.1,static,255.255.255.255,1d
dhcp-host=96:00:00:0f:42:41,198.19.0.1
# server 1000002
shared-network=172.31.1.1,198.19.0.2
dhcp-range=198.19.0.2,static,255.255.255.255,1d
dhcp-host=96:00:00:0f:42:42,198.19.0.2
# server 1000003
shared-network=172.31.1.1,100.64.0.3
dhcp-range=100.64.0.3,static,255.255.255.255,1d
dhcp-host=96:00:00:0f:42:43,set:ipv6only,100.64.0.3
### private.2
# dnsmasq for the private network 1000020, built by hlabd.
port=0
interface=private.2
bind-dynamic
dhcp-authoritative
leasefile-ro
dhcp-option=option:netmask,255.255.255.255
dhcp-option=option:router
dhcp-option=option:dns-server
dhcp-option=option:mtu,1450
dhcp-option=tag:!private-only,121,10.0.0.1/32,0.0.0.0,10.0.0.0/16,10.0.0.1
dhcp-option=tag:!private-only,249,10.0.0.1/32,0.0.0.0,10.0.0.0/16,10.0.0.1
dhcp-option=tag:private-only,121,10.0.0.1/32,0.0.0.0,10.0.0.0/16,10.0.0.1,169.254.169.254/32,10.0.0.1
dhcp-option=tag:private-only,249,10.0.0.1/32,0.0.0.0,10.0.0.0/16,10.0.0.1,169.254.169.254/32,10.0.0.1
# server 1000001
shared-network=private.2,10.0.1.2
dhcp-range=10.0.1.2,static,255.255.255.255,1d
dhcp-host=86:00:00:00:00:01,10.0.1.2
# server 1000002
shared-network=private.2,10.0.1.3
dhcp-range=10.0.1.3,static,255.255.255.255,1d
