	map firewall_in4 {
		type ipv4_addr : verdict
		flags interval
		elements = { 198.19.0.1 : jump server_1000001_in, 198.19.0.3 : jump server_1000001_in }
	}
	map firewall_in6 {
		type ipv6_addr : verdict
		flags interval
		elements = { 2001:db8:1:1::/64 : jump server_1000001_in, 2001:db8:1:4::/64 : jump server_1000001_in }
	}
	map firewall_out4 {
		type ipv4_addr : verdict
		flags interval
		elements = { 198.19.0.1 : jump server_1000001_out, 198.19.0.3 : jump server_1000001_out }
	}
	map firewall_out6 {
		type ipv6_addr : verdict
		flags interval
		elements = { 2001:db8:1:1::/64 : jump server_1000001_out, 2001:db8:1:4::/64 : jump server_1000001_out }
	}

	chain firewall_out {
		type filter hook forward priority filter + 10; policy accept;
		iifname "public" oifname { "public", "uplink" } ip saddr vmap @firewall_out4
		iifname "public" oifname { "public", "uplink" } ip6 saddr vmap @firewall_out6
	}

	chain firewall_in {
		type filter hook forward priority filter + 20; policy accept;
		oifname "public" ip daddr vmap @firewall_in4
		oifname "public" ip6 daddr vmap @firewall_in6
	}

	chain server_1000001_in {
		ct state established,related accept
		tcp flags & (syn | ack) == ack accept
		jump firewall_1000010_in
		drop
	}

	chain server_1000001_out {
		ct state established,related accept
		tcp flags & (syn | ack) == ack accept
		jump firewall_1000010_out
		drop
	}

	chain firewall_1000010_in {
		ip saddr { 198.18.0.1/32, 10.0.0.0/8 } tcp dport 22 accept
		ip6 saddr { 2001:db8:0:ffff::1/128 } tcp dport 22 accept
		ip6 saddr { 2001:db8::/32 } tcp dport 80 accept
	}

	chain firewall_1000010_out {
		ip daddr { 198.19.0.2/32 } tcp dport 5432 accept
	}

