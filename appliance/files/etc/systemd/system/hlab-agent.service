[Unit]
Description=HLab agent: applies hlabd's pictures, metadata service
# The agent sets up the network itself, so it must not wait for it: it
# starts right after the local file systems and the kernel modules (hv_sock),
# before sysinit.target. Behind network.target it would wait for
# networkd-wait-online. The boot ruleset (nftables) is loaded before it.
DefaultDependencies=no
After=local-fs.target systemd-modules-load.service nftables.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
ExecStart=/usr/local/sbin/hlab-agent
# /run/hlab holds dnsmasq's configuration; it survives a restart of the
# agent, so that dnsmasq keeps it
RuntimeDirectory=hlab
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=1

[Install]
WantedBy=sysinit.target
