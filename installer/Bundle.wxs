<?xml version="1.0" encoding="utf-8"?>
<!--
  hlab-setup-<version>.exe: the setup bundle, the only entry listed in "Apps".
  Built by tools/installer (`task installer VERSION=x.y.z`) with
  -d Version=<version>, the bal and util extensions and two bind paths: <out>
  (hlab-<version>.msi) and %LocalAppData%\hlab-build-cache
  (MicrosoftEdgeWebview2Setup.exe).

  Chain: the MSI first, then the WebView2 Evergreen bootstrapper when no
  runtime is installed. The MSI goes first so that its prerequisite check
  (HlabCheckPrereq) can refuse before anything permanent is installed; the
  tray needs WebView2 only when it is launched after the chain.

  Variables:
  - KeepData (0/1, default 0, overridable): the Modify page checkbox "Keep
    projects, servers and settings"; passed as KEEPDATA. Quiet:
    hlab-setup-<version>.exe /uninstall /quiet KeepData=1
  - HLABUI=1 is passed only when the bundle runs with full UI (Burn's
    built-in WixBundleUILevel), so the prerequisite message box never blocks
    a quiet or passive run.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!-- The UpgradeCode never changes: upgrade and downgrade depend on it. -->
  <Bundle Name="HLab"
          Manufacturer="webcodingcat"
          Version="$(Version)"
          UpgradeCode="81FBE7E2-15D3-4E38-9FBA-57FC18DB72D5">

    <!-- Launch runs in the unelevated BA process, never as an MSI action.
         Theme names the built-in theme the own theme.xml is derived from
         (HyperlinkTheme); ThemeFile and LocalizationFile replace its files.
         Theme="none" writes no wixstdba data into the BA manifest and the
         bundle fails at start with 0x80070490. The hyperlink themes require
         LicenseUrl; it is empty, so the licence link and checkbox of the
         Install page stay hidden. -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
                                              LicenseUrl=""
                                              ThemeFile="$(sys.SOURCEFILEDIR)theme.xml"
                                              LocalizationFile="$(sys.SOURCEFILEDIR)theme.wxl"
                                              SuppressOptionsUI="yes"
                                              LaunchTarget="[ProgramFiles64Folder]hlab\hlab-tray.exe" />
    </BootstrapperApplication>

    <Variable Name="KeepData" Type="numeric" Value="0" bal:Overridable="yes" />

    <!-- WebView2 runtime: installed when pv (per-machine or per-user) is set
         and not 0.0.0.0. -->
    <util:RegistrySearch Id="WebView2MachineSearch" Variable="WebView2MachineVersion"
                         Root="HKLM" Bitness="always64" Result="value" Value="pv"
                         Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" />
    <util:RegistrySearch Id="WebView2UserSearch" Variable="WebView2UserVersion"
                         Root="HKCU" Result="value" Value="pv"
                         Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" />

    <Chain>
      <MsiPackage Id="hlab" SourceFile="hlab-$(Version).msi" Compressed="yes">
        <MsiProperty Name="KEEPDATA" Value="[KeepData]" />
        <MsiProperty Name="HLABUI" Value="1" Condition="WixBundleUILevel = 4" />
      </MsiPackage>

      <ExePackage Id="webview2"
                  SourceFile="MicrosoftEdgeWebview2Setup.exe"
                  Compressed="yes"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  InstallArguments="/silent /install"
                  DetectCondition="(WebView2MachineVersion AND WebView2MachineVersion &lt;&gt; &quot;0.0.0.0&quot;) OR (WebView2UserVersion AND WebView2UserVersion &lt;&gt; &quot;0.0.0.0&quot;)"
                  InstallCondition="NOT ((WebView2MachineVersion AND WebView2MachineVersion &lt;&gt; &quot;0.0.0.0&quot;) OR (WebView2UserVersion AND WebView2UserVersion &lt;&gt; &quot;0.0.0.0&quot;))" />
    </Chain>
  </Bundle>
</Wix>
