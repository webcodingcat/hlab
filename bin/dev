#!/usr/bin/env bash
# Development commands for HLab on Linux and WSL2 (docs/tools.md):
#   bin/dev lint             check formatting and style (STYLE.md)
#   bin/dev format           apply what the formatters can fix
#   bin/dev test             the unit tests, with the race detector
#   bin/dev test --windows   the unit tests built for Windows, run through
#                            WSL interop
#   bin/dev test --agent [--host]
#                            the agent's tests in a network namespace: in
#                            Docker, or with --host through sudo (CI)
#   bin/dev build            the binaries for Linux and Windows into build/
#   bin/dev spec-diff        Hetzner's current specs against compat/specs;
#                            fails if they differ
#   bin/dev spec-diff --update
#                            replace compat/specs with Hetzner's current ones
#   bin/dev smoke            the smoke tests with the hcloud CLI and OpenTofu
#                            against `hlabd --platform fake`
#   bin/dev itest [--run <pattern>]
#                            the live tests against Hyper-V, built for
#                            Windows and run with administrator rights by the
#                            task "HLab itest" (bin/dev.ps1 dev-install)
#   bin/dev appliance        the appliance's disk (VHDX) into build/appliance
#   bin/dev deploy [--keep-vms]
#                            build hlabd and restart it on Windows through
#                            the task "HLab dev" (bin/dev.ps1 dev-install);
#                            --keep-vms ends it as a crash would, so the
#                            servers keep running
#   bin/dev package          the folder install.ps1 installs from, in
#                            build/package
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly REPO
readonly TOOLS=(go tool "-modfile=${REPO}/tools/go.mod")
readonly SHFMT_FLAGS=(-i 2 -ci -bn)
readonly SPECS=(cloud hetzner)
readonly SPEC_URL="https://docs.hetzner.cloud"
readonly APPLIANCE="build/appliance/hlab-appliance.vhdx"
# the dev loop's hlabd runs elevated from here, through the task
# (bin/dev.ps1 dev-install)
readonly DEV_DIR="/mnt/c/HLabDev"
readonly DEV_TASK="HLab dev"

#######################################
# Print an error and exit.
# Arguments:
#   The message.
#######################################
die() {
  echo "bin/dev: $*" >&2
  exit 1
}

#######################################
# Exit with an install hint unless a command is on PATH.
# Arguments:
#   The command, the hint.
#######################################
need() {
  command -v "$1" >/dev/null || die "$1 is missing: $2"
}

#######################################
# Print the shell scripts of the repository, one per line.
#######################################
shell_files() {
  echo bin/dev
  git ls-files --cached --others --exclude-standard '*.sh'
}

#######################################
# Report every line of the shell scripts longer than 80 characters, which
# the Google Shell Style Guide forbids and shfmt does not check.
#######################################
check_line_length() {
  local files
  mapfile -t files < <(shell_files)
  ! awk 'length > 80 { print FILENAME ":" FNR ": " length " characters"
    found = 1 } END { exit !found }' "${files[@]}" >&2
}

#######################################
# Run PSScriptAnalyzer on every PowerShell file. In WSL2 it uses Windows
# PowerShell when pwsh is not installed.
#######################################
check_powershell() {
  local shell="pwsh" root="${REPO}"
  if ! command -v pwsh >/dev/null; then
    need powershell.exe "install PowerShell (pwsh) or run from WSL2"
    shell="powershell.exe"
    root="$(wslpath -w "${REPO}")"
  fi
  "${shell}" -NoProfile -NonInteractive -Command "
    \$ErrorActionPreference = 'Stop'
    if (-not (Get-Module -ListAvailable PSScriptAnalyzer)) {
      Write-Error 'Install-Module PSScriptAnalyzer -Scope CurrentUser'
    }
    \$found = @(Invoke-ScriptAnalyzer -Path '${root}' -Recurse)
    \$found | Format-Table -AutoSize | Out-String -Width 160
    exit [int](\$found.Count -gt 0)"
}

#######################################
# Check formatting and style of everything in the repository.
#######################################
lint() {
  need shellcheck "sudo apt install shellcheck"
  need yamllint "sudo apt install yamllint"
  local unformatted goos golangci_lint
  unformatted="$(gofmt -l cmd internal)"
  [[ -z "${unformatted}" ]] || die "gofmt would change: ${unformatted}"
  # `go tool` would build the linter for GOOS; -n builds it for this machine
  # and prints its path
  golangci_lint="$("${TOOLS[@]}" -n golangci-lint)"
  # both targets, so files for the other system are checked as well
  for goos in linux windows; do
    GOOS="${goos}" go vet ./...
    GOOS="${goos}" "${golangci_lint}" run ./...
  done
  local shell_list
  mapfile -t shell_list < <(shell_files)
  "${TOOLS[@]}" shfmt "${SHFMT_FLAGS[@]}" -d "${shell_list[@]}"
  shellcheck "${shell_list[@]}"
  check_line_length
  check_powershell
  yamllint --strict .
}

#######################################
# Apply what the formatters can fix; `lint` reports the rest.
#######################################
format() {
  local shell_list
  mapfile -t shell_list < <(shell_files)
  gofmt -w cmd internal
  "${TOOLS[@]}" golangci-lint fmt ./...
  "${TOOLS[@]}" shfmt "${SHFMT_FLAGS[@]}" -w "${shell_list[@]}"
}

#######################################
# Build the unit tests for Windows and run them through WSL interop, each
# in its package's directory as `go test` would. Windows needs no Go.
#######################################
test_windows() {
  [[ -e /proc/sys/fs/binfmt_misc/WSLInterop ]] \
    || die "test --windows needs WSL2 with interop"
  local out_dir failed=0 pkg dir exe
  out_dir="$(mktemp -d)"
  while read -r pkg dir; do
    exe="${out_dir}/${pkg//\//_}.test.exe"
    GOOS=windows CGO_ENABLED=0 go test -c -o "${exe}" "${pkg}"
    # stdin from /dev/null: the test would read the list of packages
    if (cd "${dir}" && "${exe}" </dev/null); then
      echo "ok      ${pkg} (windows)"
    else
      echo "FAIL    ${pkg} (windows)"
      failed=1
    fi
  done < <(GOOS=windows go list \
    -f '{{if or .TestGoFiles .XTestGoFiles}}{{.ImportPath}} {{.Dir}}{{end}}' \
    ./...)
  rm -rf "${out_dir}"
  return "${failed}"
}

#######################################
# Run the agent's tests (tag netns), which change links, routes and
# nftables, in a network namespace of their own: in a container without
# network, or with --host in a new namespace through sudo (CI).
# Arguments:
#   Optional --host.
#######################################
test_agent() {
  local mode="${1:-}" dir status=0
  [[ -z "${mode}" || "${mode}" == "--host" ]] || die "unknown option: ${mode}"
  dir="$(mktemp -d)"
  CGO_ENABLED=0 go test -c -tags netns -o "${dir}/agent.test" ./internal/agent
  if [[ "${mode}" == "--host" ]]; then
    sudo unshare --net -- "${dir}/agent.test" || status=$?
  else
    need docker "Docker Desktop with WSL integration, or Docker Engine"
    docker build -q -t hlab-agent-test internal/agent/testdata >/dev/null
    # /proc/sys stays read-only in a container unless systempaths allows
    # it; NET_ADMIN then limits writes to the container's own net.*
    docker run --rm --network none --cap-add NET_ADMIN --cap-add NET_RAW \
      --security-opt systempaths=unconfined -v "${dir}:/test:ro" \
      hlab-agent-test /test/agent.test || status=$?
  fi
  rm -rf "${dir}"
  return "${status}"
}

#######################################
# Build the live tests for Windows and run them with administrator rights,
# through the task "HLab itest" that bin/dev.ps1 dev-install created: the
# test, the appliance's disk (if built) and run.cmd go to C:\HLabDev\itest,
# the task runs run.cmd, and its output appears here as it comes.
# Arguments:
#   Optional: --run and a pattern of test names.
#######################################
itest() {
  [[ -e /proc/sys/fs/binfmt_misc/WSLInterop ]] \
    || die "itest needs WSL2 with interop"
  local run=""
  case "${1:-}" in
    "") ;;
    --run)
      [[ -n "${2:-}" ]] || die "--run needs a pattern"
      run=" -test.run \"$2\""
      ;;
    *) die "unknown option: $1" ;;
  esac
  local dir="${DEV_DIR}/itest"
  [[ -d "${dir}" && -w "${dir}" ]] \
    || die "${dir} is missing: bin/dev.ps1 dev-install, once as administrator"
  GOOS=windows CGO_ENABLED=0 go test -c -tags live \
    -o "${dir}/itest.test.exe" ./itest
  # Hyper-V keeps the disk open while a test's appliance runs on it
  if [[ -e "${APPLIANCE}" ]]; then
    cp --update "${APPLIANCE}" "${dir}/"
  fi
  rm -f "${dir}/itest.out" "${dir}/itest.rc"
  printf '%s\r\n' '@echo off' 'cd /d C:\HLabDev\itest' \
    "itest.test.exe -test.v -test.timeout 30m${run} > itest.out 2>&1" \
    'echo %ERRORLEVEL% > itest.rc' >"${dir}/run.cmd"
  schtasks.exe /run /tn "HLab itest" >/dev/null \
    || die "the task \"HLab itest\" did not start: bin/dev.ps1 dev-install"
  follow_itest "${dir}"
}

#######################################
# Print the live tests' output as it grows, until the task writes the exit
# code (at most 40 minutes), and return it.
# Arguments:
#   The folder of the live tests.
#######################################
follow_itest() {
  local dir="$1" printed=0 size waited=0
  while [[ ! -e "${dir}/itest.rc" ]]; do
    ((waited < 2400)) || die "the live tests did not finish in 40 minutes"
    sleep 1
    ((++waited))
    [[ -e "${dir}/itest.out" ]] || continue
    size="$(stat -c %s "${dir}/itest.out")"
    if ((size > printed)); then
      # head stops at the measured size and tail reads all of that, so that
      # neither gets SIGPIPE when the file grows meanwhile (pipefail would
      # end the script with 141 while the tests still run)
      head -c "${size}" "${dir}/itest.out" | tail -c "$((size - printed))"
      printed="${size}"
    fi
  done
  tail -c "+$((printed + 1))" "${dir}/itest.out" 2>/dev/null || true
  return "$(tr -dc '0-9' <"${dir}/itest.rc")"
}

#######################################
# Tell whether an hlabd.exe runs on Windows. tasklist's own messages are in
# Windows' language; a running one prints its image name.
#######################################
hlabd_runs() {
  tasklist.exe /fi "IMAGENAME eq hlabd.exe" /fo csv /nh | grep -q hlabd.exe
}

#######################################
# Wait until no hlabd.exe runs, at most a minute.
#######################################
wait_for_hlabd_end() {
  local waited=0
  while hlabd_runs; do
    ((waited < 300)) || die "hlabd.exe still runs after a minute"
    sleep 0.2
    ((++waited))
  done
}

#######################################
# Build hlabd and the CLI, stop the dev loop's hlabd, copy the new one to
# C:\HLabDev\bin with the appliance's disk, start it through the task
# "HLab dev" and wait until it answers (13.11 of the dev loop).
# Arguments:
#   Optional --keep-vms: end hlabd as a crash would (schtasks /end), so that
#   the servers and the appliance keep running and the start takes them over.
#######################################
deploy() {
  [[ -e /proc/sys/fs/binfmt_misc/WSLInterop ]] \
    || die "deploy needs WSL2 with interop"
  local keep_vms=false
  case "${1:-}" in
    "") ;;
    --keep-vms) keep_vms=true ;;
    *) die "unknown option: $1" ;;
  esac
  [[ -d "${DEV_DIR}/bin" && -w "${DEV_DIR}/bin" ]] \
    || die "${DEV_DIR}/bin is missing: bin/dev.ps1 dev-install, once as" \
      "administrator"
  [[ -e "${APPLIANCE}" || -e "${DEV_DIR}/bin/hlab-appliance.vhdx" ]] \
    || die "the appliance's disk is missing: bin/dev appliance"
  local started stopped
  started="$(date +%s%N)"
  build >/dev/null
  # the CLI finds the dev loop's lab through the instance file; naming its
  # token keeps deploy right after an installed HLab ran
  export HLAB_TOKEN_FILE="${DEV_DIR}/data/control.token"
  if hlabd_runs; then
    if [[ "${keep_vms}" == true ]]; then
      schtasks.exe /end /tn "${DEV_TASK}" >/dev/null
    else
      build/linux/hlab stop >/dev/null
    fi
    wait_for_hlabd_end
  fi
  stopped="$(date +%s%N)"
  cp build/windows/hlabd.exe build/windows/hlab.exe "${DEV_DIR}/bin/"
  if [[ -e "${APPLIANCE}" ]]; then
    # the appliance runs on a copy in the data folder; a newer disk makes
    # the start update a running appliance (docs/service.md).
    # An appliance that runs on this disk itself (named hlab-appliance)
    # holds it open; the start replaces it, and the next deploy copies.
    cp --update "${APPLIANCE}" "${DEV_DIR}/bin/" \
      || echo "bin/dev: a running appliance holds the old disk;" \
        "deploy again to take the new one" >&2
  fi
  schtasks.exe /run /tn "${DEV_TASK}" >/dev/null \
    || die "the task \"${DEV_TASK}\" did not start: bin/dev.ps1 dev-install"
  local waited=0
  until build/linux/hlab status >/dev/null 2>&1; do
    # the task takes a moment to start hlabd; after that, an hlabd that
    # ended will not answer
    if ((waited >= 900)) || { ((waited >= 25)) && ! hlabd_runs; }; then
      tail -n 20 "${DEV_DIR}/data/logs/hlabd.log" >&2 || true
      die "hlabd did not come up; its log: ${DEV_DIR}/data/logs/hlabd.log"
    fi
    sleep 0.2
    ((++waited))
  done
  local ended
  ended="$(date +%s%N)"
  build/linux/hlab status
  echo "deployed in $(((ended - started) / 1000000)) ms (stop" \
    "$(((stopped - started) / 1000000)) ms, start" \
    "$(((ended - stopped) / 1000000)) ms)"
}

#######################################
# Fill build/package with what install.ps1 installs: hlabd and the CLI for
# Windows, the CLI for Linux, the appliance's disk and install.ps1 itself.
#######################################
package() {
  [[ -e "${APPLIANCE}" ]] || die "the appliance's disk is missing:" \
    "bin/dev appliance"
  build
  rm -rf build/package
  mkdir -p build/package
  cp build/windows/hlabd.exe build/windows/hlab.exe build/linux/hlab \
    "${APPLIANCE}" install/install.ps1 build/package/
  echo "built build/package: run install.ps1 there as administrator"
}

#######################################
# Build the binaries without cgo: everything for Linux, the service and the
# CLI for Windows.
#######################################
build() {
  local version
  version="$(git describe --always --dirty --match 'v[0-9]*.[0-9]*')"
  local flags=(-trimpath -ldflags "-X main.version=${version}")
  CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build "${flags[@]}" -o build/linux/ ./cmd/...
  CGO_ENABLED=0 GOOS=windows GOARCH=amd64 \
    go build "${flags[@]}" -o build/windows/ ./cmd/hlabd ./cmd/hlab
  echo "built ${version} into build/linux and build/windows"
}

#######################################
# Compare Hetzner's current specs with those in compat/specs, and replace
# them when asked to. Returns 1 if a spec differs and is not replaced.
# Arguments:
#   Optional --update.
#######################################
spec_diff() {
  local update="${1:-}"
  [[ -z "${update}" || "${update}" == "--update" ]] \
    || die "unknown option: ${update}"
  need curl "sudo apt install curl"
  local dir name kept fetched changed=0
  dir="$(mktemp -d)"
  for name in "${SPECS[@]}"; do
    kept="compat/specs/${name}.spec.json"
    fetched="${dir}/${name}.spec.json"
    curl -fsSL -o "${fetched}" "${SPEC_URL}/${name}.spec.json"
    if cmp -s "${kept}" "${fetched}"; then
      echo "${name}: unchanged"
      continue
    fi
    changed=1
    echo "${name}: changed"
    git diff --no-index --stat "${kept}" "${fetched}" || true
    [[ -z "${update}" ]] || cp "${fetched}" "${kept}"
  done
  rm -rf "${dir}"
  if ((changed)) && [[ -z "${update}" ]]; then
    echo "bin/dev spec-diff --update takes them over (DEVELOPING.md)" >&2
    return 1
  fi
}

#######################################
# Run the smoke tests (docs/tools.md) against `hlabd --platform fake`
# in a fresh data folder: the hcloud CLI with the commands of the phases so
# far, and OpenTofu with every examples/tofu-* (apply, an empty plan,
# destroy). Runs in a subshell, so that its trap cleans up on any exit.
#######################################
smoke() (
  need hcloud "the version in compat/versions.yaml"
  need tofu "the version in compat/versions.yaml"
  need ssh-keygen "sudo apt install openssh-client"
  need python3 "sudo apt install python3"
  local dir hlabd_pid="" images_pid="" control="" images="" own_ip example
  dir="$(mktemp -d)"
  trap '[[ -z "${hlabd_pid}" ]] || kill "${hlabd_pid}" 2>/dev/null
    [[ -z "${images_pid}" ]] || kill "${images_pid}" 2>/dev/null
    rm -rf "${dir}"' EXIT
  mkdir "${dir}/data" "${dir}/images"
  # any free ports and no waiting, so that it runs beside a lab in use
  printf 'time_scale: 0\nports: {cloud: 0, hetzner: 0, control: 0}\n' \
    >"${dir}/data/hlab.yaml"
  # the fake machine's servers need an image, but not a real one: a small
  # qcow2 from a local server stands in for Debian's
  cp internal/imagefmt/testdata/plain.qcow2 "${dir}/images/debian.qcow2"
  (cd "${dir}/images" && sha256sum debian.qcow2 >SHA256SUMS)
  python3 -u -m http.server 0 --bind 127.0.0.1 --directory "${dir}/images" \
    >"${dir}/images.log" 2>&1 &
  images_pid=$!
  for _ in {1..50}; do
    images="$(grep -o 'port [0-9]*' "${dir}/images.log" | cut -d' ' -f2)" \
      && break
    sleep 0.1
  done
  [[ -n "${images}" ]] || die "the image server did not start"
  images="http://127.0.0.1:${images}"
  cat >"${dir}/data/catalog.yaml" <<EOF
images:
  - id: 310554929
    name: debian-13
    description: Debian 13
    os_flavor: debian
    os_version: "13"
    architecture: x86
    disk_size: 5
    created: 2025-08-18T06:15:25Z
    rapid_deploy: true
    source: {url: "${images}/debian.qcow2", checksums: "${images}/SHA256SUMS"}
EOF
  CGO_ENABLED=0 go build -o "${dir}/bin/" ./cmd/hlabd ./cmd/hlab
  "${dir}/bin/hlabd" --platform fake --data "${dir}/data" \
    2>"${dir}/hlabd.log" &
  hlabd_pid=$!
  for _ in {1..100}; do
    control="$(grep -o 'HLAB_CONTROL=[^ "]*' "${dir}/hlabd.log")" && break
    kill -0 "${hlabd_pid}" 2>/dev/null || break
    sleep 0.1
  done
  [[ -n "${control}" ]] || die "hlabd did not start: $(cat "${dir}/hlabd.log")"
  export "${control?}" HLAB_TOKEN_FILE="${dir}/data/control.token"
  # the CLI's own config would hold the user's contexts
  export HCLOUD_CONFIG="${dir}/hcloud.toml"
  eval "$("${dir}/bin/hlab" env)"
  ssh-keygen -q -t ed25519 -N "" -C smoke -f "${dir}/id_ed25519"
  TF_VAR_public_key="$(cat "${dir}/id_ed25519.pub")"
  export TF_VAR_public_key

  set -x
  hcloud server-type list
  hcloud location list
  hcloud ssh-key create --name smoke \
    --public-key-from-file "${dir}/id_ed25519.pub"
  hcloud ssh-key list
  hcloud primary-ip create --name smoke-ip --type ipv4 --location fsn1
  hcloud server create --name smoke --type cpx22 --image debian-13 \
    --location fsn1 --ssh-key smoke
  hcloud server list
  hcloud server describe smoke
  hcloud server poweroff smoke
  own_ip="$(hcloud server ip smoke)"
  hcloud primary-ip unassign "$(hcloud primary-ip list -o noheader \
    -o columns=id,ip | awk -v ip="${own_ip}" '$2 == ip {print $1}')"
  hcloud primary-ip assign --server smoke smoke-ip
  hcloud server poweron smoke
  hcloud server reboot smoke
  hcloud server reset smoke
  hcloud server shutdown smoke
  hcloud primary-ip list
  hcloud server delete smoke
  hcloud primary-ip delete smoke-ip
  # phase 2a: networks, firewalls and Floating IPs, also in a create
  hcloud network create --name smoke-net --ip-range 10.0.0.0/16
  hcloud network add-subnet smoke-net --type cloud \
    --network-zone eu-central --ip-range 10.0.1.0/24
  hcloud network add-route smoke-net --destination 10.100.0.0/24 \
    --gateway 10.0.1.5
  hcloud firewall create --name smoke-fw
  hcloud firewall add-rule smoke-fw --direction in --protocol tcp \
    --port 22 --source-ips 0.0.0.0/0 --source-ips ::/0
  hcloud server create --name smoke-a --type cpx22 --image debian-13 \
    --location fsn1 --ssh-key smoke --network smoke-net --firewall smoke-fw
  hcloud server create --name smoke-b --type cpx22 --image debian-13 \
    --location fsn1 --ssh-key smoke --label role=db
  hcloud server attach-to-network smoke-b --network smoke-net \
    --ip 10.0.1.10
  hcloud server change-alias-ips smoke-b --network smoke-net \
    --alias-ips 10.0.1.11
  hcloud firewall apply-to-resource smoke-fw --type label_selector \
    --label-selector role=db
  hcloud firewall describe smoke-fw
  hcloud floating-ip create --name smoke-fip --type ipv4 \
    --home-location fsn1
  hcloud floating-ip assign smoke-fip smoke-a
  hcloud floating-ip assign smoke-fip smoke-b
  hcloud floating-ip unassign smoke-fip
  hcloud floating-ip list
  hcloud network describe smoke-net
  hcloud server detach-from-network smoke-b --network smoke-net
  hcloud firewall remove-from-resource smoke-fw --type label_selector \
    --label-selector role=db
  hcloud server delete smoke-a smoke-b
  hcloud floating-ip delete smoke-fip
  hcloud firewall delete smoke-fw
  hcloud network delete smoke-net
  hcloud ssh-key delete smoke
  for example in examples/tofu-*; do
    cp -r "${example}" "${dir}/tofu"
    tofu -chdir="${dir}/tofu" init -input=false
    tofu -chdir="${dir}/tofu" apply -input=false -auto-approve
    # exit code 2 means the plan has changes
    tofu -chdir="${dir}/tofu" plan -input=false -detailed-exitcode
    tofu -chdir="${dir}/tofu" destroy -input=false -auto-approve
    rm -rf "${dir}/tofu"
  done
  "${dir}/bin/hlab" stop
  set +x
  wait "${hlabd_pid}"
  hlabd_pid=""
  echo "smoke tests passed"
)

#######################################
# Build the appliance's disk with the agent of this working tree
# (docs/appliance.md).
#######################################
appliance() {
  local started=${SECONDS}
  build
  appliance/build.sh build/linux/hlab-agent "${APPLIANCE}"
  echo "built ${APPLIANCE} ($(du -h "${APPLIANCE}" | cut -f1)) in" \
    "$((SECONDS - started)) s"
}

main() {
  cd "${REPO}"
  case "${1:-}" in
    lint) lint ;;
    format) format ;;
    test)
      case "${2:-}" in
        "")
          need gcc "sudo apt install gcc (the race detector needs cgo)"
          # -count=1: the layer test reads packages through the go command,
          # which the test cache does not see
          CGO_ENABLED=1 go test -race -count=1 ./...
          ;;
        --windows) test_windows ;;
        --agent) test_agent "${3:-}" ;;
        *) die "unknown option: $2" ;;
      esac
      ;;
    build) build ;;
    spec-diff) spec_diff "${2:-}" ;;
    smoke) smoke ;;
    itest) itest "${2:-}" "${3:-}" ;;
    appliance) appliance ;;
    deploy) deploy "${2:-}" ;;
    package) package ;;
    *)
      sed -n '2,/^set /p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//' >&2
      exit 2
      ;;
  esac
}

main "$@"
