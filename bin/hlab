#!/usr/bin/env bash
# The lab from the Docker host (Linux, macOS, Git Bash on Windows):
#   bin/hlab [-c hlab.yaml] up         build the image if needed, start the lab
#                                      container hlab-<name>
#   bin/hlab [-c hlab.yaml] down       stop it (VM disks and state stay in the
#                                      volume hlab-<name>)
#   bin/hlab [-c hlab.yaml] purge      stop it and delete the volume
#   bin/hlab [-c hlab.yaml] logs | shell | build
#   bin/hlab [-c hlab.yaml] test       style checks (STYLE.md) and unit tests
#   bin/hlab [-c hlab.yaml] lint       style checks only
#   bin/hlab [-c hlab.yaml] format     apply what the formatters can fix
#   bin/hlab [-c hlab.yaml] itest [pytest args]
#                                      live tests with VMs in the running lab
#                                      (resets it first)
#   bin/hlab [-c hlab.yaml] <command>  any other command runs inside the lab:
#                                      status, env, ssh, fault, client, ...
# The configuration defaults to $HLAB_CONFIG or ./hlab.yaml; without a file
# the lab "demo" runs with defaults.
set -euo pipefail
export MSYS_NO_PATHCONV=1
# byte order for the globs below: the image hash must match bin/hlab.ps1
export LC_ALL=C
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

config="${HLAB_CONFIG:-hlab.yaml}"
explicit="${HLAB_CONFIG:+1}"
if [[ "${1:-}" == "-c" || "${1:-}" == "--config" ]]; then
  config="$2"
  explicit=1
  shift 2
fi
# a mistyped path must not mean the lab "demo"
if [[ -n "${explicit}" && ! -f "${config}" ]]; then
  echo "hlab: no such configuration: ${config}" >&2
  exit 2
fi
name=demo
cfgmount=()
if [[ -f "${config}" ]]; then
  n="$(sed -n 's/^name:[[:space:]]*["'\'']\{0,1\}\([A-Za-z0-9_-]*\).*/\1/p' \
    "${config}" | head -1)"
  [[ -n "${n}" ]] && name="${n}"
  dir="$(cd "$(dirname "${config}")" && (pwd -W 2>/dev/null || pwd))"
  cfgmount=(-v "${dir}:/config:ro"
    -e "HLAB_CONFIG=/config/$(basename "${config}")")
fi
container="hlab-${name}"
hash="$(cat "${root}/Dockerfile" "${root}"/scripts/* "${root}"/hlabd/*.py \
  "${root}"/hlabd/*/*.py "${root}"/hlabd/*/*/*.py "${root}"/tests/*.py \
  "${root}"/tests/tofu-smoke/*.tf "${root}"/tests/tofu-smoke/*.sh \
  "${root}"/itests/*.py | sha256sum | cut -c1-12)"
image="hlab:${hash}"
# the development tools (STYLE.md), built on top of the lab image
dev_image="hlab-dev:${hash}"
src="$(cd "${root}" && (pwd -W 2>/dev/null || pwd))"

# build [target] [image]: the lab image (or the dev image), unless it exists
build() {
  local target="${1:-lab}" tagged="${2:-${image}}"
  docker image inspect "${tagged}" >/dev/null 2>&1 && return 0
  echo "Building ${tagged} ..." >&2
  docker build -q --target "${target}" -t "${tagged}" "${src}" >/dev/null
  # older builds go (those a container still uses stay: docker refuses to
  # remove them)
  docker images "${tagged%%:*}" --format '{{.Repository}}:{{.Tag}}' \
    | grep -vxF "${tagged}" | xargs -r docker rmi >/dev/null 2>&1 || true
}

# lint check|fix: the style checks or fixes (STYLE.md), tools/lint.sh in the
# dev image and tofu fmt in OpenTofu's
lint() {
  local tofu_args=(fmt -check -diff -recursive)
  [[ "$1" == fix ]] && tofu_args=(fmt -recursive)
  build dev "${dev_image}"
  docker run --rm -v "${src}:/src" --entrypoint bash "${dev_image}" \
    /src/tools/lint.sh "$1"
  docker run --rm -v "${src}/tests/tofu-smoke:/work" -w /work \
    ghcr.io/opentofu/opentofu:1 "${tofu_args[@]}"
}

tty=(-i)
[[ -t 0 && -t 1 ]] && tty=(-it)

case "${1:-}" in
  build) build ;;
  up)
    build
    # a running lab shuts its guests down first
    docker stop "${container}" >/dev/null 2>&1 || true
    docker rm -f "${container}" >/dev/null 2>&1 || true
    docker run -d --name "${container}" --init --privileged \
      --device /dev/kvm --device /dev/net/tun \
      --stop-timeout 20 -e "HLAB_NAME=${name}" -v "${container}:/hlab" \
      ${cfgmount[@]+"${cfgmount[@]}"} "${image}" serve >/dev/null
    # the start's log until the lab is ready (or the container ends): image
    # downloads take a while
    shown=0
    while true; do
      log="$(docker logs "${container}" 2>&1)"
      printf '%s\n' "${log}" | tail -n +"$((shown + 1))"
      shown="$(printf '%s\n' "${log}" | wc -l)"
      grep -q "hlab ready" <<<"${log}" && break
      [[ "$(docker inspect -f '{{.State.Running}}' "${container}" \
        2>/dev/null)" == true ]] || exit 1
      sleep 1
    done
    ;;
  down)
    docker stop "${container}" >/dev/null 2>&1 || true
    docker rm -f "${container}" >/dev/null 2>&1 || true
    ;;
  purge)
    "$0" -c "${config}" down
    docker volume rm "${container}" >/dev/null 2>&1 || true
    ;;
  logs) docker logs -f "${container}" ;;
  shell) docker exec "${tty[@]}" "${container}" bash ;;
  lint) lint check ;;
  format) lint fix ;;
  test)
    lint check
    build
    docker run --rm --entrypoint python3 -w /opt/hlab "${image}" \
      -m pytest -q -p no:cacheprovider tests
    ;;
  itest)
    shift
    exec docker exec "${tty[@]}" -e HLAB_LIVE=1 -w /opt/hlab/itests \
      "${container}" python3 -m pytest -p no:cacheprovider -v "$@"
    ;;
  "")
    # the comment block at the top of this file
    awk 'NR > 1 && !/^#/ { exit } NR > 1' "$0"
    exit 2
    ;;
  # box user <name> <key file>: the key file is on this host, the command runs
  # in the container
  box)
    if [[ "${2:-}" == user && -n "${4:-}" && "${4}" != - && -f "${4}" ]]; then
      exec docker exec -i "${container}" hlab box user "$3" - <"$4"
    fi
    exec docker exec "${tty[@]}" "${container}" hlab "$@"
    ;;
  *) exec docker exec "${tty[@]}" "${container}" hlab "$@" ;;
esac
