#!/usr/bin/env bash
# The lab from the Docker host (Linux, macOS; WSL on Windows):
#   bin/hlab [-c hlab.yaml] up         build the image (cached), start the lab
#                                      container hlab-<name>
#   bin/hlab [-c hlab.yaml] down       stop it (VM disks and state stay in the
#                                      volume hlab-<name>)
#   bin/hlab [-c hlab.yaml] purge      stop it and delete the volume
#   bin/hlab [-c hlab.yaml] logs | shell | build
#   bin/hlab [-c hlab.yaml] test       style checks (STYLE.md) and unit tests
#   bin/hlab [-c hlab.yaml] lint       style checks only
#   bin/hlab [-c hlab.yaml] format     apply what the formatters can fix
#   bin/hlab [-c hlab.yaml] itest [pytest args]
#                                      live tests with VMs in the running lab
#                                      (resets it first)
#   bin/hlab [-c hlab.yaml] proxy <host> <port>
#                                      stdin and stdout to a TCP port in the
#                                      lab's network: ssh -o ProxyCommand=
#                                      "bin/hlab proxy %h %p" root@<server>
#   bin/hlab [-c hlab.yaml] box <arguments>
#                                      the Storage Box inside the lab; "box
#                                      user <name> <key file>" reads the key
#                                      file here
#   bin/hlab [-c hlab.yaml] image export <id> <file>
#                                      write an image of the project (a
#                                      snapshot or backup) to a qcow2 file here
#   bin/hlab [-c hlab.yaml] image export <id> --volume <volume>:<path>
#                                      the same into a file in a Docker volume
#   bin/hlab [-c hlab.yaml] image import <file> [--description <text>]
#                            [--label <key>=<value> ...]
#                                      add a qcow2 file here to the project as
#                                      a snapshot; prints its ID
#   bin/hlab [-c hlab.yaml] image import --volume <volume>:<path> [...]
#                                      the same from a file in a Docker volume
#   bin/hlab [-c hlab.yaml] <command>  any other command runs inside the lab:
#                                      status, env, ssh, fault, client, ...
# The configuration defaults to $HLAB_CONFIG or ./hlab.yaml; without a file
# the lab "demo" runs with defaults.
set -euo pipefail

# The repository, mounted into the development containers.
SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly SRC
readonly IMAGE=hlab:latest
# The development tools (STYLE.md), built on top of the lab image.
readonly DEV_IMAGE=hlab-dev:latest
readonly TOFU_IMAGE=ghcr.io/opentofu/opentofu:1
# The ports of the web UI and the SOCKS5 proxy inside the container (UI_PORT
# and SOCKS_PORT in hlabd/config.py).
readonly UI_PORT=8480
readonly SOCKS_PORT=1080
# Where run_image puts its transfer files: in the lab's volume, beside the
# images.
readonly TRANSFER_DIR=/hlab/transfer

# Set by load_config.
lab_name=demo
container=hlab-demo
config_mount=()
# on the host's localhost
ui_port="${UI_PORT}"
socks_port="${SOCKS_PORT}"
# Set by main.
tty_flags=(-i)
# Set by read_volume_file: the Docker volume and the path in it of
# run_image's --volume.
volume_name=""
volume_path=""
# Set by run_image, removed when the wrapper ends (remove_image_copies).
transfer_file=""
partial_file=""

# print_usage: Print the comment block at the top of this file.
print_usage() {
  awk 'NR > 1 && !/^#/ { exit } NR > 1' "$0"
}

# read_setting <file> <key>: Print a top-level "<key>:" value of a
# configuration file, plain or quoted, a comment after it allowed; nothing if
# it has none, "?" if its line holds no such value.
read_setting() {
  local file="$1" key_name="$2" line
  local key="^${key_name}[[:space:]]*:[[:space:]]*"
  # "value", 'value' or value
  local value='("([^"]*)"|'\''([^'\'']*)'\''|([^[:space:]]*))'
  local pattern="${key}${value}([[:space:]]+#.*)?[[:space:]]*\$"
  line="$(grep -m 1 -E "${key}" "${file}" | tr -d '\r')" || true
  if [[ -z "${line}" ]]; then
    return 0
  fi
  if [[ "${line}" =~ ${pattern} ]]; then
    echo "${BASH_REMATCH[2]}${BASH_REMATCH[3]}${BASH_REMATCH[4]}"
  else
    echo "?"
  fi
}

# read_lab_name <file>: Print the top-level "name:" of a configuration file;
# nothing if it has none. The name becomes part of Docker names, so other
# characters stop the wrapper instead of being cut off.
read_lab_name() {
  local file="$1" name
  name="$(read_setting "${file}" name)"
  if [[ ! "${name}" =~ ^[A-Za-z0-9_-]*$ ]]; then
    echo "hlab: ${file}: the name may only have letters, digits, - and _" >&2
    exit 2
  fi
  echo "${name}"
}

# read_port <file> <key>: Print a top-level port setting of a configuration
# file; nothing if it has none. Anything but a port number stops the wrapper.
read_port() {
  local file="$1" key="$2" port
  port="$(read_setting "${file}" "${key}")"
  if [[ -n "${port}" ]] && [[ ! "${port}" =~ ^[0-9]{1,5}$ ]]; then
    echo "hlab: ${file}: ${key} must be a port number" >&2
    exit 2
  fi
  echo "${port}"
}

# load_config <file> <explicit>: Take the lab's name and ports from the
# configuration file and mount its directory into the container. Without the
# file the lab "demo" runs with defaults, unless the file was named
# explicitly: a mistyped path must not mean the lab "demo".
# Globals:
#   lab_name, container, config_mount, ui_port, socks_port (set)
load_config() {
  local config="$1" explicit="$2"
  local configured_name configured_port config_dir
  if [[ ! -f "${config}" ]]; then
    if [[ -n "${explicit}" ]]; then
      echo "hlab: no such configuration: ${config}" >&2
      exit 2
    fi
    return 0
  fi
  configured_name="$(read_lab_name "${config}")"
  if [[ -n "${configured_name}" ]]; then
    lab_name="${configured_name}"
    container="hlab-${lab_name}"
  fi
  configured_port="$(read_port "${config}" ui_port)"
  ui_port="${configured_port:-${ui_port}}"
  configured_port="$(read_port "${config}" socks_port)"
  socks_port="${configured_port:-${socks_port}}"
  config_dir="$(cd "$(dirname "${config}")" && pwd)"
  config_mount=(-v "${config_dir}:/config:ro"
    -e "HLAB_CONFIG=/config/$(basename "${config}")")
}

# build_image <target> <tag>: Build a stage of the Dockerfile. Docker's layer
# cache makes this quick when nothing has changed.
build_image() {
  local target="$1" tag="$2"
  echo "Building ${tag} ..." >&2
  docker build -q --target "${target}" -t "${tag}" "${SRC}" >/dev/null
  prune_images
}

# prune_images: Remove the untagged images that rebuilds leave behind (all
# carry the label hlab=1). One that a container still uses stays until a
# later prune.
prune_images() {
  docker image prune -f --filter label=hlab=1 >/dev/null 2>&1 || true
}

# run_lint <check|fix>: Run the style checks or fixes (STYLE.md): tools/lint.sh
# in the development image, tofu fmt in OpenTofu's image.
run_lint() {
  local mode="$1"
  local tofu_args=(fmt -check -diff -recursive)
  if [[ "${mode}" == fix ]]; then
    tofu_args=(fmt -recursive)
  fi
  build_image dev "${DEV_IMAGE}"
  docker run --rm -v "${SRC}:/src" --entrypoint bash "${DEV_IMAGE}" \
    /src/tools/lint.sh "${mode}"
  docker run --rm -v "${SRC}/tests/tofu-smoke:/work" -w /work \
    "${TOFU_IMAGE}" "${tofu_args[@]}"
}

# stop_lab: Stop and remove the lab container; the volume with the VM disks
# and the lab's state stays.
# Globals:
#   container (read)
stop_lab() {
  docker stop "${container}" >/dev/null 2>&1 || true
  docker rm -f "${container}" >/dev/null 2>&1 || true
}

# start_lab: Start the lab container afresh and show its log until the lab
# is ready (or the container ends). Loading the OS images takes a while.
# Globals:
#   lab_name, container, config_mount, ui_port, socks_port (read)
start_lab() {
  local log running shown=0
  build_image lab "${IMAGE}"
  # A running lab shuts its guests down first.
  stop_lab
  docker run -d --name "${container}" --init --privileged \
    --device /dev/kvm --device /dev/net/tun \
    --stop-timeout 20 -e "HLAB_NAME=${lab_name}" -v "${container}:/hlab" \
    -p "127.0.0.1:${ui_port}:${UI_PORT}" \
    -p "127.0.0.1:${socks_port}:${SOCKS_PORT}" \
    ${config_mount[@]+"${config_mount[@]}"} "${IMAGE}" serve >/dev/null
  # The old container is gone, and with it the last user of an old image.
  prune_images
  while true; do
    log="$(docker logs "${container}" 2>&1)"
    printf '%s\n' "${log}" | tail -n +"$((shown + 1))"
    shown="$(printf '%s\n' "${log}" | wc -l)"
    if grep -q "hlab ready" <<<"${log}"; then
      return 0
    fi
    running="$(docker inspect -f '{{.State.Running}}' "${container}" \
      2>/dev/null || true)"
    if [[ "${running}" != true ]]; then
      exit 1
    fi
    sleep 1
  done
}

# run_proxy <host> <port>: Connect stdin and stdout to a TCP port in the lab's
# network, from the container (source 192.0.2.2, like any tool in the lab's
# namespace). SSH uses it as its ProxyCommand.
# Globals:
#   container (read)
run_proxy() {
  if (($# != 2)); then
    echo "usage: hlab proxy <host> <port>" >&2
    exit 2
  fi
  local host="$1" port="$2"
  if [[ "${host}" == *:* ]]; then
    host="[${host}]" # socat wants an IPv6 address in brackets
  fi
  exec docker exec -i "${container}" socat - "TCP:${host}:${port}"
}

# run_box <box arguments>: Run "hlab box" in the container. For "box user
# <name> <key file>" read the key file on this host and hand it to the
# container on stdin; anything else goes to the container as it is.
# Globals:
#   container, tty_flags (read)
run_box() {
  local subcommand="${1:-}" user="${2:-}" key_file="${3:-}"
  # "-" already means stdin inside the container.
  if [[ "${subcommand}" == user && "${key_file}" != - ]] \
    && [[ -f "${key_file}" ]]; then
    exec docker exec -i "${container}" hlab box user "${user}" - \
      <"${key_file}"
  fi
  exec docker exec "${tty_flags[@]}" "${container}" hlab box "$@"
}

# remove_image_copies: Remove run_image's transfer file in the container and
# an export cut off half way here.
# Globals:
#   container, transfer_file, partial_file (read)
remove_image_copies() {
  if [[ -n "${transfer_file}" ]]; then
    docker exec "${container}" rm -f "${transfer_file}" >/dev/null 2>&1 || true
  fi
  if [[ -n "${partial_file}" ]]; then
    rm -f "${partial_file}"
  fi
}

# read_volume_file <volume>:<path>: Split run_image's --volume into the
# volume and the path in it; fail unless both are given and the volume
# exists.
# Globals:
#   volume_name, volume_path (set)
read_volume_file() {
  local volume_file="$1"
  volume_name="${volume_file%%:*}"
  # from the volume's root, with or without a leading /
  volume_path="${volume_file#*:}"
  volume_path="${volume_path#/}"
  if [[ "${volume_file}" != *:* || -z "${volume_name}" ||
    -z "${volume_path}" ]]; then
    echo "hlab: --volume takes <volume>:<path>, not ${volume_file}" >&2
    exit 2
  fi
  if ! docker volume inspect "${volume_name}" >/dev/null 2>&1; then
    echo "hlab: no such Docker volume: ${volume_name}" >&2
    exit 2
  fi
}

# copy_volume_file <export|import>: Copy between the transfer file and the
# file of read_volume_file in a short-lived container that mounts both
# volumes, so the image stays inside Docker (a bind mount or docker cp would
# take it through this host's file system). The lab's volume is named like
# its container (start_lab). An export gets its name only once it is whole;
# its directory must exist in the volume.
# Globals:
#   IMAGE, container, transfer_file, volume_name, volume_path (read)
# sh -c <script> <$0> <$1> ...: the scripts' $1 to $3 are the arguments after
# "copy", expanded by the sh in the container, not here
# shellcheck disable=SC2016
copy_volume_file() {
  # 0644: the transfer file has mktemp's 0600
  local export_script='part="$2.part"; cp "$1" "$part" && chmod 644 "$part"'
  export_script+=' && mv -f "$part" "$2" || { rm -f "$part"; exit 1; }'
  local import_script='[ -f "$1" ] || { echo "hlab: no such file: $3" >&2'
  import_script+='; exit 2; }; cp "$1" "$2"'
  if [[ "$1" == export ]]; then
    docker run --rm -v "${container}:/hlab:ro" -v "${volume_name}:/target" \
      --entrypoint sh "${IMAGE}" -c "${export_script}" \
      copy "${transfer_file}" "/target/${volume_path}"
  else
    docker run --rm -v "${container}:/hlab" -v "${volume_name}:/source:ro" \
      --entrypoint sh "${IMAGE}" -c "${import_script}" \
      copy "/source/${volume_path}" "${transfer_file}" \
      "${volume_name}:${volume_path}"
  fi
}

# run_image <export|import> <arguments>: Move an image of the project between
# the lab and a qcow2 file on this host or in a Docker volume (--volume). The
# file passes through a transfer file in the container, on docker exec's
# stdin or stdout (no host paths for docker to translate) or through
# copy_volume_file, and "hlab image" there copies it into or out of the
# project. An export gets its name only once it is whole.
# Globals:
#   container, volume_name (read)
#   transfer_file, partial_file (set)
run_image() {
  local subcommand="${1:-}" image_id file="" options=()
  case "${subcommand}" in
    export)
      if (($# == 4)) && [[ "$3" == --volume ]]; then
        read_volume_file "$4"
      elif (($# == 3)) && [[ "$3" != --volume ]]; then
        file="$3"
      else
        echo "usage: hlab image export <id>" \
          "(<file> | --volume <volume>:<path>)" >&2
        exit 2
      fi
      image_id="$2"
      ;;
    import)
      if [[ "${2:-}" == --volume ]] && (($# >= 3)); then
        read_volume_file "$3"
        options=("${@:4}")
      elif (($# >= 2)) && [[ "$2" != --volume ]]; then
        file="$2"
        options=("${@:3}")
        if [[ ! -f "${file}" ]]; then
          echo "hlab: no such file: ${file}" >&2
          exit 2
        fi
      else
        echo "usage: hlab image import (<file> | --volume <volume>:<path>)" \
          "[--description <text>] [--label <key>=<value> ...]" >&2
        exit 2
      fi
      ;;
    *)
      echo "usage: hlab image export|import ..." >&2
      exit 2
      ;;
  esac
  trap remove_image_copies EXIT
  docker exec "${container}" mkdir -p "${TRANSFER_DIR}"
  transfer_file="$(docker exec "${container}" mktemp -p "${TRANSFER_DIR}")"
  if [[ "${subcommand}" == export ]]; then
    docker exec "${container}" \
      hlab image export "${image_id}" "${transfer_file}"
    if [[ -n "${volume_name}" ]]; then
      copy_volume_file export
    else
      partial_file="${file}.part"
      docker exec "${container}" cat "${transfer_file}" >"${partial_file}"
      mv -f "${partial_file}" "${file}"
      partial_file=""
    fi
  else
    if [[ -n "${volume_name}" ]]; then
      copy_volume_file import
    else
      docker exec -i "${container}" cp /dev/stdin "${transfer_file}" <"${file}"
    fi
    docker exec "${container}" hlab image import "${transfer_file}" \
      ${options[@]+"${options[@]}"}
  fi
}

# main [-c <file>] <command> [arguments]: Run the command; see the comment
# block at the top.
# Globals:
#   container (read)
#   tty_flags (set)
main() {
  local config="${HLAB_CONFIG:-hlab.yaml}" explicit="${HLAB_CONFIG:+1}"
  if [[ "${1:-}" == -c || "${1:-}" == --config ]]; then
    if (($# < 2)); then
      echo "hlab: $1 needs a configuration file" >&2
      exit 2
    fi
    config="$2"
    explicit=1
    shift 2
  fi
  load_config "${config}" "${explicit}"
  # docker exec gets a terminal only when both ends are one: redirected output
  # must not get a terminal's line endings.
  if [[ -t 0 && -t 1 ]]; then
    tty_flags=(-it)
  fi

  case "${1:-}" in
    build) build_image lab "${IMAGE}" ;;
    up) start_lab ;;
    down) stop_lab ;;
    purge)
      stop_lab
      docker volume rm "${container}" >/dev/null 2>&1 || true
      ;;
    logs) docker logs -f "${container}" ;;
    shell) docker exec "${tty_flags[@]}" "${container}" bash ;;
    lint) run_lint check ;;
    format) run_lint fix ;;
    test)
      # run_lint builds the development image, which carries the unit tests
      run_lint check
      # NET_ADMIN: nft -c checks the rulesets against the kernel
      docker run --rm --cap-add NET_ADMIN --entrypoint python3 \
        -w /opt/hlab "${DEV_IMAGE}" -m pytest -q -p no:cacheprovider tests
      ;;
    itest)
      exec docker exec "${tty_flags[@]}" -e HLAB_LIVE=1 \
        -w /opt/hlab/itests "${container}" \
        python3 -m pytest -p no:cacheprovider -v "${@:2}"
      ;;
    proxy) run_proxy "${@:2}" ;;
    box) run_box "${@:2}" ;;
    image) run_image "${@:2}" ;;
    "")
      print_usage >&2
      exit 2
      ;;
    *) exec docker exec "${tty_flags[@]}" "${container}" hlab "$@" ;;
  esac
}

# sourced (the unit tests): only the functions
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
